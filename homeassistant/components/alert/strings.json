{
  "config": {
    "step": {
      "user": {
        "description": "Set up the Alert integration to create alert entities from the UI. Individual alerts are added as sub-entries after setup."
      }
    }
  },
  "config_subentries": {
    "alert": {
      "entry_type": "Alert",
      "initiate_flow": {
        "reconfigure": "Edit alert",
        "user": "Add alert"
      },
      "step": {
        "user": {
          "title": "Add alert",
          "data": {
            "name": "[%key:common::config_flow::data::name%]",
            "entity_id": "Entity",
            "repeat": "Repeat interval (minutes)",
            "state": "Trigger state",
            "can_acknowledge": "Can acknowledge",
            "skip_first": "Skip first notification",
            "message": "Message",
            "done_message": "Done message",
            "title": "Notification title",
            "notifiers": "Notifiers",
            "data": "Extra data (YAML)"
          },
          "data_description": {
            "entity_id": "The entity whose state will be watched to trigger the alert.",
            "repeat": "Minutes between repeated notifications while the alert is active.",
            "state": "The entity state value that triggers the alert.",
            "message": "Notification message. Supports Jinja2 templates.",
            "done_message": "Message sent when the alert clears. Use 'clear_notification' for mobile apps. Supports Jinja2 templates.",
            "title": "Notification title. Supports Jinja2 templates.",
            "notifiers": "One notification service name per line (e.g. notify.mobile_app_my_phone).",
            "data": "Extra parameters to pass to the notification service, as a YAML mapping."
