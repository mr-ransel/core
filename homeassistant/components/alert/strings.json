            "repeat": "[%key:component::alert::config_subentries::alert::step::user::data::repeat%]",
            "state": "[%key:component::alert::config_subentries::alert::step::user::data::state%]",
            "can_acknowledge": "[%key:component::alert::config_subentries::alert::step::user::data::can_acknowledge%]",
            "skip_first": "[%key:component::alert::config_subentries::alert::step::user::data::skip_first%]",
            "message": "[%key:component::alert::config_subentries::alert::step::user::data::message%]",
            "done_message": "[%key:component::alert::config_subentries::alert::step::user::data::done_message%]",
            "title": "[%key:component::alert::config_subentries::alert::step::user::data::title%]",
            "notifiers": "[%key:component::alert::config_subentries::alert::step::user::data::notifiers%]",
            "data": "[%key:component::alert::config_subentries::alert::step::user::data::data%]"
          },
          "data_description": {
            "entity_id": "[%key:component::alert::config_subentries::alert::step::user::data_description::entity_id%]",
            "repeat": "[%key:component::alert::config_subentries::alert::step::user::data_description::repeat%]",
            "state": "[%key:component::alert::config_subentries::alert::step::user::data_description::state%]",
            "message": "[%key:component::alert::config_subentries::alert::step::user::data_description::message%]",
            "done_message": "[%key:component::alert::config_subentries::alert::step::user::data_description::done_message%]",
            "title": "[%key:component::alert::config_subentries::alert::step::user::data_description::title%]",
            "notifiers": "[%key:component::alert::config_subentries::alert::step::user::data_description::notifiers%]",
            "data": "[%key:component::alert::config_subentries::alert::step::user::data_description::data%]"
          }
        }
      },
      "error": {
        "invalid_data": "The data field must be a valid YAML mapping (key: value pairs).",
        "invalid_yaml": "Invalid YAML in the data field."
      },
      "abort": {
        "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]"
      }
    }
